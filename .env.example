# =============================================================================
# SentinelLoop — Environment Variables
# Copy this file to .env and fill in all values before running docker-compose.
# NEVER commit .env to git — add it to .gitignore.
# =============================================================================

# --- PostgreSQL ---
DATABASE_URL=postgresql://sentinel:sentinel_secret@postgres:5432/sentinelloop

# --- Redis (broker + result backend + rate-limit store) ---
REDIS_URL=redis://redis:6379/0

# --- OpenAI (used by LLM judge in detection_engine/llm_judge.py) ---
# Model: gpt-4o-mini — calls are hard-capped at MAX_LLM_CALLS_PER_SCAN per scan
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Application secret (general signing/session key — not used for token encryption) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-value-in-production

# --- Token encryption key ---
# Used for PBKDF2HMAC-SHA256 key derivation (480,000 iterations).
# MUST be at least 16 characters — startup will raise ValueError if shorter.
#
# GENERATE with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# PERFORMANCE NOTE:
#   First decrypt after process start: ~200-400ms (PBKDF2 computation).
#   Subsequent decrypts of the same token: <1ms (lru_cache hit).
#   Acceptable for MVP. For production at scale (1000+ targets), migrate to
#   AWS Secrets Manager + KMS envelope encryption.
#
# SECURITY NOTE:
#   In production, DO NOT store this in .env committed to git.
#   Use: AWS Secrets Manager, GCP Secret Manager, or HashiCorp Vault.
TOKEN_ENCRYPTION_KEY=REPLACE-ME-generate-with-secrets.token_hex-32

# --- Application settings ---
ENVIRONMENT=development

# How often (seconds) the watcher polls each target for deployment changes
WATCHER_INTERVAL_SECONDS=300

# Hard cap on OpenAI API calls per scan (prevents runaway costs)
# Checked via Redis counter BEFORE each gpt-4o-mini call in llm_judge.py
MAX_LLM_CALLS_PER_SCAN=50
